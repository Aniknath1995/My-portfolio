<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Anik Debnath · Finance & Accounts Executive</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
/* ═══════════════════════════════════════════════════════
   TOKENS & RESET
═══════════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --obsidian:#07090f;
  --deep:#0d1117;
  --surface:#111827;
  --panel:#131c2e;
  --card:#0f1520;
  --gold:#c9922a;
  --gold-light:#e8b84b;
  --gold-pale:#f5d98a;
  --gold-glow:rgba(201,146,42,.22);
  --silver:#a8b3c5;
  --text:#dde3ee;
  --muted:#6b7a90;
  --dim:#3a4558;
  --teal:#1a8c7e;
  --teal-light:#2ac4b0;
  --border:rgba(201,146,42,.14);
  --border-s:rgba(201,146,42,.30);
  --glass:rgba(13,17,23,.72);
  --ff-display:'Cormorant Garamond',serif;
  --ff-body:'Outfit',sans-serif;
  --ff-mono:'JetBrains Mono',monospace;
  --ease-out:cubic-bezier(.16,1,.3,1);
  --ease-spring:cubic-bezier(.34,1.56,.64,1);
}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{
  background:var(--obsidian);color:var(--text);
  font-family:var(--ff-body);font-size:16px;line-height:1.7;
  overflow-x:hidden;cursor:none;
}
::selection{background:var(--gold-glow);color:var(--gold-pale)}

/* ── NOISE OVERLAY ─────────────────────────────────── */
body::before{
  content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
  opacity:.028;mix-blend-mode:overlay;
}

/* ── SCROLL PROGRESS ───────────────────────────────── */
#scroll-prog{
  position:fixed;top:0;left:0;height:2px;z-index:9990;
  background:linear-gradient(90deg,var(--gold),var(--gold-pale));
  width:0%;transition:width .08s linear;
}

/* ── CURSOR ────────────────────────────────────────── */
#cur{
  position:fixed;width:8px;height:8px;border-radius:50%;
  background:var(--gold-light);pointer-events:none;z-index:9999;
  transform:translate(-50%,-50%);
  transition:transform .1s var(--ease-spring),width .2s,height .2s,opacity .2s;
  mix-blend-mode:screen;
}
#cur-ring{
  position:fixed;width:34px;height:34px;border-radius:50%;
  border:1px solid rgba(232,184,75,.5);
  pointer-events:none;z-index:9998;
  transform:translate(-50%,-50%);
  transition:width .25s var(--ease-out),height .25s var(--ease-out),opacity .25s;
  opacity:.5;
}
#cur.hovering{width:14px;height:14px}
#cur-ring.hovering{width:52px;height:52px;opacity:.3}

/* ── LOADER ────────────────────────────────────────── */
#loader{
  position:fixed;inset:0;z-index:99999;
  background:var(--obsidian);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2.5rem;
}
#loader.done{animation:fadeLoader .5s var(--ease-out) forwards}
@keyframes fadeLoader{to{opacity:0;pointer-events:none;visibility:hidden}}
.ld-symbol{
  font-family:var(--ff-display);font-size:clamp(2.5rem,8vw,5rem);
  font-weight:700;letter-spacing:-.01em;
  background:linear-gradient(135deg,var(--gold) 0%,var(--gold-pale) 50%,var(--gold) 100%);
  background-size:300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  animation:shimGrad 2s linear infinite;
}
.ld-rule{width:1px;height:60px;background:linear-gradient(to bottom,var(--gold),transparent);animation:growRule 1.8s var(--ease-out) forwards}
@keyframes growRule{from{height:0}to{height:60px}}
.ld-sub{
  font-family:var(--ff-mono);font-size:.72rem;letter-spacing:.22em;
  text-transform:uppercase;color:var(--muted);
  animation:fadeUp .8s .4s var(--ease-out) both;
}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.ld-bar{width:160px;height:1px;background:var(--dim);overflow:hidden;margin-top:.5rem}
.ld-fill{height:100%;width:0;background:linear-gradient(90deg,var(--gold),var(--gold-pale));animation:fillBar 2s var(--ease-out) forwards}
@keyframes fillBar{to{width:100%}}

/* ── CANVAS ────────────────────────────────────────── */
#canvas{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.4}

/* ── NAV ───────────────────────────────────────────── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:900;
  padding:0 clamp(1.5rem,4vw,3.5rem);
  height:70px;display:flex;align-items:center;justify-content:space-between;
  background:rgba(7,9,15,.75);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(201,146,42,.08);
  transition:background .3s,border-color .3s;
}
nav.scrolled{background:rgba(7,9,15,.95);border-color:var(--border)}
.nav-brand{
  font-family:var(--ff-display);font-size:1.15rem;font-weight:700;
  color:var(--text);letter-spacing:.02em;text-decoration:none;
  display:flex;align-items:center;gap:.6rem;
}
.nav-brand-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);flex-shrink:0;animation:pulseDot 2s ease-in-out infinite}
@keyframes pulseDot{0%,100%{box-shadow:0 0 0 0 var(--gold-glow)}50%{box-shadow:0 0 0 6px transparent}}
.nav-links{display:flex;align-items:center;gap:2rem;list-style:none}
.nav-links a{
  font-size:.78rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);text-decoration:none;transition:color .2s;position:relative;padding:.2rem 0;
}
.nav-links a::after{
  content:'';position:absolute;bottom:-2px;left:0;width:0;height:1px;
  background:var(--gold);transition:width .3s var(--ease-out);
}
.nav-links a:hover,.nav-links a.active{color:var(--text)}
.nav-links a:hover::after,.nav-links a.active::after{width:100%}
.nav-cta{
  padding:.42rem 1.2rem;border:1px solid var(--border-s);border-radius:3px;
  font-size:.78rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
  color:var(--gold-light);background:rgba(201,146,42,.07);text-decoration:none;
  transition:all .25s;
}
.nav-cta:hover{background:rgba(201,146,42,.16);border-color:var(--gold);color:var(--gold-pale)}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:none;border:none}
.hamburger span{width:20px;height:1px;background:var(--text);display:block;transition:.3s}

/* ── MOBILE MENU ───────────────────────────────────── */
.mob-menu{
  display:none;position:fixed;inset:0;z-index:800;
  background:rgba(7,9,15,.98);backdrop-filter:blur(24px);
  flex-direction:column;align-items:center;justify-content:center;gap:2.5rem;
}
.mob-menu.open{display:flex}
.mob-menu a{
  font-family:var(--ff-display);font-size:2.2rem;font-weight:600;
  color:var(--text);text-decoration:none;
  transition:color .2s;letter-spacing:.02em;
}
.mob-menu a:hover{color:var(--gold-light)}

/* ── HERO ──────────────────────────────────────────── */
#hero{
  position:relative;min-height:100vh;
  display:grid;grid-template-columns:1fr 480px;gap:0;
  overflow:hidden;
}
.hero-left{
  display:flex;flex-direction:column;justify-content:center;
  padding:9rem clamp(1.5rem,4vw,3.5rem) 6rem;
  position:relative;z-index:2;
}
.hero-eyebrow{
  display:flex;align-items:center;gap:.8rem;margin-bottom:1.8rem;
  font-family:var(--ff-mono);font-size:.72rem;letter-spacing:.2em;
  text-transform:uppercase;color:var(--gold);
  opacity:0;animation:fadeUp .8s .3s var(--ease-out) forwards;
}
.hero-eyebrow::before{content:'';width:2rem;height:1px;background:var(--gold);flex-shrink:0}
.hero-name{
  font-family:var(--ff-display);
  font-size:clamp(3.5rem,6vw,6.5rem);
  font-weight:700;line-height:.98;letter-spacing:-.02em;
  color:var(--text);margin-bottom:.4rem;
  opacity:0;animation:fadeUp .9s .45s var(--ease-out) forwards;
}
.hero-name em{
  font-style:italic;
  background:linear-gradient(135deg,var(--gold),var(--gold-pale));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hero-rule{
  width:3rem;height:1px;background:var(--gold);margin:1.5rem 0;
  opacity:0;animation:fadeUp .8s .55s var(--ease-out) forwards;
}
.hero-desc{
  max-width:440px;font-size:1rem;font-weight:300;
  color:var(--silver);line-height:1.8;
  opacity:0;animation:fadeUp .8s .65s var(--ease-out) forwards;
}
.hero-actions{
  display:flex;gap:1rem;flex-wrap:wrap;margin-top:2.5rem;
  opacity:0;animation:fadeUp .8s .78s var(--ease-out) forwards;
}
.btn{
  display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1.8rem;
  border-radius:2px;font-size:.82rem;font-weight:600;letter-spacing:.08em;
  text-transform:uppercase;text-decoration:none;cursor:pointer;
  transition:all .25s var(--ease-out);border:1px solid transparent;
  font-family:var(--ff-body);position:relative;overflow:hidden;
}
.btn-gold{
  background:linear-gradient(135deg,var(--gold),var(--gold-light));
  color:#07090f;border-color:var(--gold);
}
.btn-gold::after{
  content:'';position:absolute;inset:0;background:rgba(255,255,255,.15);
  transform:scaleX(0);transform-origin:left;transition:transform .3s;
}
.btn-gold:hover::after{transform:scaleX(1)}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(201,146,42,.35)}
.btn-ghost{
  background:transparent;color:var(--text);
  border-color:rgba(255,255,255,.15);
}
.btn-ghost:hover{border-color:var(--border-s);background:rgba(201,146,42,.06);transform:translateY(-2px)}
.hero-stats{
  display:flex;gap:3rem;margin-top:3.5rem;padding-top:2.5rem;
  border-top:1px solid rgba(255,255,255,.06);
  opacity:0;animation:fadeUp .8s .9s var(--ease-out) forwards;
}
.hero-stat-n{
  font-family:var(--ff-display);font-size:2.6rem;font-weight:700;
  line-height:1;color:var(--text);
}
.hero-stat-n span{color:var(--gold-light)}
.hero-stat-l{
  font-size:.72rem;font-weight:500;letter-spacing:.12em;
  text-transform:uppercase;color:var(--muted);margin-top:.3rem;
}

/* ── HERO RIGHT / PHOTO PANEL ──────────────────────── */
.hero-right{
  position:relative;z-index:2;overflow:hidden;
}
.hero-photo-frame{
  position:absolute;inset:0;
}
.hero-photo-frame img{
  width:100%;height:100%;object-fit:cover;object-position:center 15%;
  filter:grayscale(18%) contrast(1.05);
}
.hero-photo-frame::before{
  content:'';position:absolute;inset:0;z-index:1;
  background:linear-gradient(to right,var(--obsidian) 0%,transparent 30%,transparent 70%,rgba(7,9,15,.4) 100%),
             linear-gradient(to top,var(--obsidian) 0%,transparent 25%);
}
.hero-photo-frame::after{
  content:'';position:absolute;inset:0;z-index:1;
  background:linear-gradient(135deg,rgba(201,146,42,.08),transparent 50%);
}
.hero-photo-badge{
  position:absolute;bottom:3rem;right:2.5rem;z-index:3;
  background:rgba(13,17,23,.85);backdrop-filter:blur(16px);
  border:1px solid var(--border-s);border-radius:8px;
  padding:1rem 1.4rem;
}
.hpb-label{font-family:var(--ff-mono);font-size:.62rem;letter-spacing:.15em;color:var(--muted);text-transform:uppercase;margin-bottom:.3rem}
.hpb-val{font-family:var(--ff-display);font-size:1.05rem;font-weight:600;color:var(--gold-light)}
.available-dot{
  display:inline-flex;align-items:center;gap:.45rem;
  position:absolute;top:2rem;right:2rem;z-index:3;
  padding:.35rem .9rem;border-radius:30px;
  background:rgba(26,140,126,.15);border:1px solid rgba(42,196,176,.3);
  font-family:var(--ff-mono);font-size:.64rem;letter-spacing:.12em;
  text-transform:uppercase;color:var(--teal-light);
}
.available-dot::before{
  content:'';width:6px;height:6px;border-radius:50%;
  background:var(--teal-light);flex-shrink:0;
  animation:pulseDot 2s ease-in-out infinite;
}

/* ── MARQUEE ───────────────────────────────────────── */
.marquee-wrap{
  position:relative;z-index:1;
  border-top:1px solid rgba(255,255,255,.04);
  border-bottom:1px solid rgba(255,255,255,.04);
  background:rgba(255,255,255,.015);
  padding:.9rem 0;overflow:hidden;
}
.marquee-track{
  display:flex;width:max-content;
  animation:marquee 35s linear infinite;
}
.marquee-track:hover{animation-play-state:paused}
.marquee-item{
  white-space:nowrap;padding:0 2.5rem;
  font-family:var(--ff-mono);font-size:.68rem;letter-spacing:.18em;
  text-transform:uppercase;color:var(--muted);
  display:flex;align-items:center;gap:2rem;
}
.marquee-item::after{content:'✦';color:var(--gold);font-size:.45rem}
@keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* ── SECTIONS ──────────────────────────────────────── */
.section{padding:7rem 0;position:relative;z-index:1}
.container{max-width:1100px;margin:0 auto;padding:0 clamp(1.5rem,4vw,3.5rem)}
.section-header{margin-bottom:4.5rem}
.section-tag{
  font-family:var(--ff-mono);font-size:.68rem;letter-spacing:.22em;
  text-transform:uppercase;color:var(--gold);
  display:flex;align-items:center;gap:.7rem;margin-bottom:.9rem;
}
.section-tag::before{content:'';width:1.8rem;height:1px;background:var(--gold)}
.section-title{
  font-family:var(--ff-display);font-size:clamp(2.2rem,4vw,3.5rem);
  font-weight:700;line-height:1.05;letter-spacing:-.01em;color:var(--text);
}
.section-title em{font-style:italic;color:var(--gold-light)}
.section-sub{
  font-size:.97rem;color:var(--muted);margin-top:1rem;
  max-width:480px;line-height:1.8;font-weight:300;
}

/* ── ABOUT ─────────────────────────────────────────── */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}
.about-photo-wrap{position:relative}
.about-photo{
  width:100%;aspect-ratio:3/4;object-fit:cover;object-position:center 10%;
  border-radius:4px;filter:grayscale(10%);
  position:relative;z-index:1;
}
.about-photo-frame{
  position:relative;
}
.about-photo-frame::before{
  content:'';position:absolute;
  top:16px;left:16px;right:-16px;bottom:-16px;
  border:1px solid var(--border-s);border-radius:4px;z-index:0;
  transition:transform .4s var(--ease-out);
}
.about-photo-frame:hover::before{transform:translate(4px,4px)}
.about-photo-frame::after{
  content:'';position:absolute;inset:0;z-index:2;border-radius:4px;
  background:linear-gradient(135deg,rgba(201,146,42,.12),transparent 60%);
  pointer-events:none;
}
.about-tag{
  position:absolute;bottom:-1.5rem;right:-1.5rem;z-index:3;
  background:var(--panel);border:1px solid var(--border-s);border-radius:4px;
  padding:1rem 1.4rem;min-width:140px;
}
.about-tag-n{font-family:var(--ff-display);font-size:2rem;font-weight:700;color:var(--gold-light);line-height:1}
.about-tag-l{font-size:.72rem;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;margin-top:.3rem}
.about-body h3{
  font-family:var(--ff-display);font-size:1.7rem;font-weight:600;
  color:var(--text);margin-bottom:1.2rem;line-height:1.2;
}
.about-body p{font-size:.97rem;color:var(--silver);line-height:1.85;font-weight:300;margin-bottom:1rem}
.about-pills{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.8rem}
.pill{
  padding:.35rem .9rem;border-radius:2px;font-size:.77rem;font-weight:500;
  background:rgba(201,146,42,.08);border:1px solid rgba(201,146,42,.2);
  color:var(--gold-light);letter-spacing:.04em;transition:.2s;
}
.pill:hover{background:rgba(201,146,42,.16);border-color:var(--gold)}

/* ── EXPERIENCE ────────────────────────────────────── */
.exp-section{background:var(--deep)}
.exp-grid{display:grid;grid-template-columns:1fr 2fr;gap:5rem;align-items:start}
.exp-sidebar{position:sticky;top:6rem}
.exp-sidebar p{font-size:.9rem;color:var(--muted);line-height:1.8;margin-top:1rem;font-weight:300}
.timeline{position:relative}
.timeline::before{
  content:'';position:absolute;left:0;top:6px;bottom:0;width:1px;
  background:linear-gradient(to bottom,var(--gold),rgba(201,146,42,.1),transparent);
}
.tl-item{padding-left:2.2rem;padding-bottom:3.5rem;position:relative}
.tl-item:last-child{padding-bottom:0}
.tl-dot{
  position:absolute;left:-5px;top:6px;
  width:11px;height:11px;border-radius:50%;
  background:var(--gold);border:2px solid var(--deep);
  box-shadow:0 0 0 4px rgba(201,146,42,.15),0 0 20px rgba(201,146,42,.3);
}
.tl-dot.current{
  background:var(--gold-pale);
  animation:currentPulse 2s ease-in-out infinite;
}
@keyframes currentPulse{
  0%,100%{box-shadow:0 0 0 4px rgba(201,146,42,.15),0 0 20px rgba(201,146,42,.3)}
  50%{box-shadow:0 0 0 8px rgba(201,146,42,.08),0 0 40px rgba(201,146,42,.5)}
}
.tl-date{
  font-family:var(--ff-mono);font-size:.65rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--gold);margin-bottom:.6rem;
}
.tl-role{
  font-family:var(--ff-display);font-size:1.4rem;font-weight:600;
  color:var(--text);margin-bottom:.25rem;line-height:1.2;
}
.tl-company{
  font-size:.87rem;font-weight:500;color:var(--gold-light);
  margin-bottom:1.2rem;display:flex;align-items:center;gap:.5rem;
}
.tl-company::before{content:'@';color:var(--muted);font-size:.78rem}
.tl-list{list-style:none;display:flex;flex-direction:column;gap:.6rem}
.tl-list li{
  font-size:.9rem;color:var(--muted);
  display:grid;grid-template-columns:auto 1fr;gap:.7rem;
  line-height:1.6;
}
.tl-list li::before{content:'—';color:var(--dim);flex-shrink:0;margin-top:.05rem}

/* ── SKILLS ────────────────────────────────────────── */
.skills-wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.skill-card{
  background:var(--card);border:1px solid rgba(255,255,255,.06);
  border-radius:6px;padding:2rem;
  transition:border-color .3s,transform .3s,box-shadow .3s;
  position:relative;overflow:hidden;
}
.skill-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
  opacity:0;transition:opacity .3s;
}
.skill-card:hover{
  border-color:rgba(201,146,42,.2);
  transform:translateY(-3px);
  box-shadow:0 16px 40px rgba(0,0,0,.4),0 0 0 1px rgba(201,146,42,.1) inset;
}
.skill-card:hover::before{opacity:1}
.skill-card-icon{font-size:1.4rem;margin-bottom:1.2rem}
.skill-card-title{
  font-family:var(--ff-display);font-size:1.05rem;font-weight:600;
  color:var(--text);margin-bottom:1.5rem;
}
.sbar{margin-bottom:1rem}
.sbar:last-child{margin-bottom:0}
.sbar-top{display:flex;justify-content:space-between;margin-bottom:.45rem}
.sbar-name{font-size:.82rem;color:var(--silver);font-weight:400}
.sbar-pct{font-family:var(--ff-mono);font-size:.68rem;color:var(--muted)}
.sbar-track{height:3px;background:rgba(255,255,255,.05);border-radius:2px;overflow:hidden}
.sbar-fill{
  height:100%;width:0;border-radius:2px;
  background:linear-gradient(90deg,var(--gold),var(--gold-light));
  transition:width 1.4s var(--ease-out);
}
.soft-skills{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.55rem;padding:1.5rem 2rem}
.soft-skills .skill-card-title{margin-bottom:1.2rem;width:100%}
.sk-chip{
  padding:.32rem .85rem;border-radius:2px;font-size:.77rem;font-weight:500;
  background:rgba(201,146,42,.07);border:1px solid rgba(201,146,42,.16);
  color:var(--silver);letter-spacing:.03em;transition:.2s;
}
.sk-chip:hover{background:rgba(201,146,42,.15);color:var(--gold-light)}

/* ── EDUCATION ─────────────────────────────────────── */
.edu-section{background:var(--deep)}
.edu-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem}
.edu-card{
  background:var(--card);border:1px solid rgba(255,255,255,.06);
  border-radius:6px;padding:2rem;position:relative;overflow:hidden;
  transition:border-color .3s,transform .3s;cursor:default;
}
.edu-card:hover{border-color:rgba(201,146,42,.25);transform:translateY(-4px)}
.edu-level{
  font-family:var(--ff-mono);font-size:.64rem;letter-spacing:.18em;
  text-transform:uppercase;color:var(--teal-light);margin-bottom:.8rem;
}
.edu-degree{
  font-family:var(--ff-display);font-size:1.15rem;font-weight:600;
  color:var(--text);margin-bottom:.35rem;line-height:1.25;
}
.edu-inst{font-size:.87rem;color:var(--gold-light);font-weight:500;margin-bottom:.6rem}
.edu-meta{font-size:.8rem;color:var(--muted)}
.edu-gpa{
  display:inline-flex;align-items:center;gap:.4rem;margin-top:1rem;
  padding:.28rem .8rem;border-radius:2px;
  background:rgba(201,146,42,.08);border:1px solid rgba(201,146,42,.18);
  font-family:var(--ff-mono);font-size:.68rem;color:var(--gold-pale);
}
.edu-card-num{
  position:absolute;bottom:.8rem;right:1.2rem;
  font-family:var(--ff-display);font-size:4rem;font-weight:700;
  color:rgba(255,255,255,.025);line-height:1;pointer-events:none;
  user-select:none;
}

/* ── PROJECTS ──────────────────────────────────────── */
.projects-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem}
.proj-card{
  background:var(--card);border:1px solid rgba(255,255,255,.06);
  border-radius:6px;padding:2rem;position:relative;overflow:hidden;
  transition:border-color .3s,transform .3s,box-shadow .3s;cursor:default;
}
.proj-card::after{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--gold),var(--teal-light));
  transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease-out);
}
.proj-card:hover::after{transform:scaleX(1)}
.proj-card:hover{
  border-color:rgba(201,146,42,.2);
  transform:translateY(-4px);
  box-shadow:0 20px 50px rgba(0,0,0,.5);
}
.proj-type{
  font-family:var(--ff-mono);font-size:.62rem;letter-spacing:.18em;
  text-transform:uppercase;color:var(--teal-light);margin-bottom:.8rem;
  display:flex;align-items:center;gap:.5rem;
}
.proj-type::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0}
.proj-title{
  font-family:var(--ff-display);font-size:1.2rem;font-weight:600;
  color:var(--text);margin-bottom:.3rem;line-height:1.2;
}
.proj-date{font-family:var(--ff-mono);font-size:.68rem;color:var(--muted);margin-bottom:.9rem}
.proj-desc{font-size:.88rem;color:var(--muted);line-height:1.75;font-weight:300}
.proj-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.2rem}
.proj-tag{
  padding:.22rem .65rem;border-radius:2px;font-size:.7rem;font-weight:500;
  background:rgba(26,140,126,.1);border:1px solid rgba(42,196,176,.2);
  color:var(--teal-light);letter-spacing:.03em;
}

/* ── CONTACT ───────────────────────────────────────── */
.contact-section{background:var(--deep);overflow:hidden;position:relative}
.contact-bg{
  position:absolute;inset:0;z-index:0;
  background:radial-gradient(ellipse 60% 60% at 80% 50%,rgba(201,146,42,.06) 0%,transparent 70%);
}
.contact-ripples{
  position:absolute;right:-5%;top:50%;transform:translateY(-50%);
  width:500px;height:500px;z-index:0;
}
.c-ripple{
  position:absolute;border-radius:50%;
  border:1px solid rgba(201,146,42,.12);
  top:50%;left:50%;transform:translate(-50%,-50%);
  animation:cRipple 4s ease-in-out infinite;
}
.c-ripple:nth-child(1){width:200px;height:200px;animation-delay:0s}
.c-ripple:nth-child(2){width:330px;height:330px;animation-delay:1s}
.c-ripple:nth-child(3){width:460px;height:460px;animation-delay:2s}
@keyframes cRipple{
  0%,100%{opacity:.6;transform:translate(-50%,-50%) scale(.97)}
  50%{opacity:.2;transform:translate(-50%,-50%) scale(1.03)}
}
.contact-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start}
.contact-list{display:flex;flex-direction:column;gap:1rem;margin-top:2.5rem}
.c-item{
  display:flex;align-items:center;gap:1.2rem;
  padding:1.1rem 1.4rem;background:var(--card);
  border:1px solid rgba(255,255,255,.06);border-radius:4px;
  transition:border-color .25s,transform .25s;
}
.c-item:hover{border-color:rgba(201,146,42,.25);transform:translateX(4px)}
.c-icon{
  width:40px;height:40px;border-radius:4px;flex-shrink:0;
  background:rgba(201,146,42,.08);border:1px solid rgba(201,146,42,.18);
  display:flex;align-items:center;justify-content:center;font-size:1rem;
}
.c-label{font-family:var(--ff-mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:.2rem}
.c-val{font-size:.92rem;color:var(--text);font-weight:400}
.contact-cta{padding:3rem;background:var(--card);border:1px solid rgba(255,255,255,.06);border-radius:6px;text-align:center}
.cta-title{
  font-family:var(--ff-display);font-size:2.2rem;font-weight:700;
  color:var(--text);line-height:1.15;margin-bottom:1rem;
}
.cta-title em{font-style:italic;color:var(--gold-light)}
.cta-sub{font-size:.92rem;color:var(--muted);line-height:1.8;margin-bottom:2rem;font-weight:300}

/* ── FOOTER ────────────────────────────────────────── */
footer{
  position:relative;z-index:1;
  border-top:1px solid rgba(255,255,255,.05);
  padding:2.5rem clamp(1.5rem,4vw,3.5rem);
